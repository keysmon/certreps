# Supabase project URL - Supabase dashboard > Project Settings > API > Project URL (public, safe to expose).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase anon/public key - Supabase dashboard > Project Settings > API > Project API keys > anon public (RLS-guarded, safe to expose).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
